+            "coefficient_minutes": 7.5,
+            "unit": "complexity_point",
+            "batchability": 0.8,
+            "discount_floor": 0.25,
+        }
+
+        assert RemediationFunction.model_validate(payload).model_dump(mode="json") == payload
