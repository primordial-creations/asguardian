+    )
+    def test_rejects_unknown_enum_values(self, field, value):
+        with pytest.raises(ValidationError):
+            _finding(**{field: value})
+
+    def test_json_shape_uses_wire_enum_values(self):
+        payload = _finding(
+            category=CsharpRuleCategory.SECURITY,
